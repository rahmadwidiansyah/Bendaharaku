APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE="Asia/Jakarta"


APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=300
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Web Push (VAPID) — generate dengan: php artisan notification:generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bendaharaku.id

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_client_secret"
GOOGLE_REDIRECT_URI="https://your_domain/auth/google/callback"

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
AI_PARSER_URL=http://ai-parser:3987

# OCR — Tesseract primary (ringan), RapidOCR fallback (ONNX) — untuk server 2GB
OCR_ENGINE=auto
OCR_FALLBACK=rapid
OCR_URL=http://ocr-service:8000
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MIN_TEXT_LEN=20
TESSERACT_PSM=6
TESSERACT_LANG=ind+eng
OCR_RAPID_URL=http://ocr-service:8000

# Evidence LLM — kirim hasil OCR text ke LLM API untuk pengelompokan transaksi otomatis (regex terlalu rumit)
EVIDENCE_LLM_ENABLED=true
EVIDENCE_LLM_FALLBACK_THRESHOLD=0.6
EVIDENCE_LLM_PRIMARY=false
# OpenAI API Compatible (provider default — contoh: 9router)
# Endpoint lengkap ke /chat/completions dari gateway yang dipakai
OPENAI_COMPAT_BASE_URL=https://api.9router.com/v1/chat/completions
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
# Header rahasia tambahan (opsional), misalnya: X-Api-Key / rahasia123
OPENAI_COMPAT_SECRET_HEADER_NAME=
OPENAI_COMPAT_SECRET_HEADER_VALUE=
